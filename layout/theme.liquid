<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 %}
        &ndash; Page {{ current_page -}}
      {%- endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless -%}
    </title>

    {%- assign meta_description = page_description | default: shop.description -%}
    {% if meta_description != blank %}
      <meta name="description" content="{{ meta_description | strip_html | truncate: 320 | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'fonts' %}

    <script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'CustomEase.min.js' | asset_url }}" defer="defer"></script>

    <script src="{{ 'format-money.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'base-component.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'side-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'rating-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'card-swatches.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom-tabs.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'marquee-slider.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {{ 'tailwind.output.css' | asset_url | stylesheet_tag }}

    {%- if localization.available_languages.size > 1 -%}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="font-primary antialiased has-[[data-scroll-lock=true]]:overflow-hidden">
    <a class="sr-only" href="#MainContent"> Skip to main content </a>

    {% render 'loading-bar' %}

    {%- render 'cart-drawer' -%}
    {%- render 'search-drawer' -%}
    {%- render 'quick-view' -%}
    {%- capture side_drawer_content -%}
      <p class="text-sm text-gray-600">Side drawer content goes here.</p>
    {%- endcapture -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class="min-h-[50vh]"
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'javascript-strings' %}
    {% render 'newsletter-popup' %}
    {% section 'cookie-consent' %}
  </body>
</html>
