{%- comment -%}
  Figma: Components Molecules / Quick view content
  Fetched by quick-view.js (?section_id=quick-view-product) and shown in the quick view drawer.
  Desktop: gallery and product form in two equal columns. Mobile: stacked; the drawer body scrolls.
{%- endcomment -%}
{%- assign full_details_label = 'sections.quick_view.view_full_details' | t -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}

<product-info
  id="QuickViewProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="false"
  data-url="{{ product.url }}"
>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

  <div class="flex flex-col gap-6 lg:grid lg:grid-cols-2">
    {% render 'media-gallery', product: product, layout: 'carousel', show_zoom: false, sizes: '(min-width: 1024px) 400px, 100vw', section_id: section.id %}

    <div class="flex flex-col gap-6">
      {% render 'product-title-block', product: product %}
      {% render 'product-price-block', product: product %}
      {% render 'product-form', product: product, section_id: section.id, product_form_id: product_form_id %}
      {% render 'link', label: full_details_label, href: product.url %}
    </div>
  </div>
</product-info>
