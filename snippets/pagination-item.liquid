{%- comment -%}
  Figma: Components Atoms / Pagination item
  type      number | previous | next | ellipsis | previous-text | next-text   (Figma: Type)
  label     number text
  href      link; without it the item is current (number) or disabled (previous/next)
  current   boolean
  States: Hover = :hover, Current = [aria-current], Disabled = [aria-disabled]
{%- endcomment -%}
{%- liquid
  assign type = type | default: 'number'
  assign base = 'pagination-item inline-flex h-10 min-w-10 items-center justify-center gap-1 rounded-button text-label-base transition-colors'
  assign prev_label = 'general.pagination.previous' | t
  assign next_label = 'general.pagination.next' | t
-%}
{%- case type -%}
  {%- when 'ellipsis' -%}
    <span class="{{ base }} px-2 text-text-muted" aria-hidden="true">…</span>
  {%- when 'previous' or 'next' or 'previous-text' or 'next-text' -%}
    {%- liquid
      if type contains 'previous'
        assign icon = 'icon__chevron-left.svg'
        assign text = prev_label
      else
        assign icon = 'icon__chevron-right.svg'
        assign text = next_label
      endif
      if type contains 'text'
        assign pad = 'px-3'
      else
        assign pad = 'px-2'
      endif
    -%}
    {%- if href -%}
      <a class="{{ base }} {{ pad }} text-text hover:bg-surface focus-visible:outline-none focus-visible:border focus-visible:border-focus" href="{{ href }}" aria-label="{{ text | escape }}" data-type="{{ type }}">
        {%- if type == 'next-text' %}<span>{{ text }}</span>{% endif -%}
        <span class="size-5 [&>svg]:size-full" aria-hidden="true">{{ icon | inline_asset_content }}</span>
        {%- if type == 'previous-text' %}<span>{{ text }}</span>{% endif -%}
      </a>
    {%- else -%}
      <span class="{{ base }} {{ pad }} text-text-disabled" aria-disabled="true" data-type="{{ type }}">
        {%- if type == 'next-text' %}<span>{{ text }}</span>{% endif -%}
        <span class="size-5 [&>svg]:size-full" aria-hidden="true">{{ icon | inline_asset_content }}</span>
        {%- if type == 'previous-text' %}<span>{{ text }}</span>{% endif -%}
      </span>
    {%- endif -%}
  {%- else -%}
    {%- assign page_label = 'general.pagination.page' | t: number: label -%}
    {%- if current -%}
      <span class="{{ base }} px-2 bg-accent text-accent-contrast" aria-current="page" aria-label="{{ page_label | escape }}" data-type="number">{{ label }}</span>
    {%- else -%}
      <a class="{{ base }} px-2 text-text hover:bg-surface focus-visible:outline-none focus-visible:border focus-visible:border-focus" href="{{ href }}" aria-label="{{ page_label | escape }}" data-type="number">{{ label }}</a>
    {%- endif -%}
{%- endcase -%}
