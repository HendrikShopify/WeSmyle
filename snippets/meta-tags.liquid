{%- comment -%}
  Social and structured meta for every page, rendered in <head> by theme.liquid.
  Open Graph + Twitter card with fallbacks: description falls back to shop.description, image to the template's page_image, then the latest article image (blog), then settings.share_image.
  BreadcrumbList JSON-LD follows the same trail as the breadcrumbs snippet (product, collection, blog, article, page).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_image = page_image
  assign t = template | split: '.' | first
  case t
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'blog'
      if og_image == blank
        assign og_image = blog.articles.first.image
      endif
  endcase
  if og_image == blank and settings.share_image
    assign og_image = settings.share_image
  endif
  assign home_label = 'general.breadcrumbs.home' | t
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">
{%- if og_image %}
<meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
<meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif %}
{%- if t == 'product' and product.selected_or_first_available_variant %}
<meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- if t == 'article' %}
<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
<meta property="article:author" content="{{ article.author | escape }}">
{%- for tag in article.tags %}
<meta property="article:tag" content="{{ tag | escape }}">
{%- endfor %}
{%- endif %}
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">

{%- liquid
  assign crumbs = ''
  assign origin = request.origin
  case t
    when 'product'
      if collection
        assign crumbs = crumbs | append: collection.title | append: '|' | append: origin | append: collection.url | append: '||'
      endif
      assign crumbs = crumbs | append: product.title | append: '|' | append: origin | append: product.url | append: '||'
    when 'collection'
      assign crumbs = crumbs | append: collection.title | append: '|' | append: origin | append: collection.url | append: '||'
    when 'blog'
      assign crumbs = crumbs | append: blog.title | append: '|' | append: origin | append: blog.url | append: '||'
    when 'article'
      assign crumbs = crumbs | append: blog.title | append: '|' | append: origin | append: blog.url | append: '||'
      assign crumbs = crumbs | append: article.title | append: '|' | append: origin | append: article.url | append: '||'
    when 'page'
      assign crumbs = crumbs | append: page.title | append: '|' | append: origin | append: page.url | append: '||'
  endcase
  assign crumb_list = crumbs | split: '||'
-%}
{%- if crumb_list.size > 0 %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ home_label | json }}, "item": {{ origin | append: routes.root_url | json }} }
      {%- for crumb in crumb_list -%}
        {%- assign parts = crumb | split: '|' -%}
        ,{ "@type": "ListItem", "position": {{ forloop.index | plus: 1 }}, "name": {{ parts[0] | json }}, "item": {{ parts[1] | json }} }
      {%- endfor %}
    ]
  }
</script>
{%- endif %}
