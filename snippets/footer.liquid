{%- comment -%}
  Figma: Sections / Footer (210:1263)
  Brand (logo, about text, social links), up to three menu columns (accordions below lg) and the newsletter, a divider, then copyright and policies, the language and country switchers and the payment icons.
  Menus: the top-level links of the `footer` menu are the column headings, their child links the column links; a menu without child links becomes one column titled with the menu name; without a `footer` menu the main menu is used. Policies come from shop.policies. Texts: locale keys `footer.*`.
  The Figma toggles (Show newsletter, Show social, Show localization, Show payment icons) are not parameters; a store removes what it does not need from this file.
{%- endcomment -%}
{%- liquid
  assign menu = linklists['footer']
  if menu == blank
    assign menu = linklists['main-menu']
  endif
  assign nested = false
  for column in menu.links
    if column.links.size > 0
      assign nested = true
    endif
  endfor
  assign about = 'footer.about' | t
  assign year = 'now' | date: '%Y'
  assign copyright = 'footer.copyright' | t: year: year, shop: shop.name
  assign legal_label = 'footer.legal_label' | t
  assign menu_label = 'footer.menu_label' | t
-%}
{%- capture logo -%}{% render 'header__logo' %}{%- endcapture -%}
{%- capture legal -%}
  <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-body-xs text-text-muted" role="list">
    <li>{{ copyright }}</li>
    {%- for policy in shop.policies -%}
      <li><a href="{{ policy.url }}" class="rounded-xs transition-colors hover:text-text focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ policy.title | escape }}</a></li>
    {%- endfor -%}
  </ul>
{%- endcapture -%}
<footer class="footer bg-surface">
    <div class="mx-auto flex w-full max-w-page flex-col gap-10 px-page-margin pb-8 pt-12 lg:gap-16 lg:pt-20">
      <div class="flex flex-col gap-10 lg:grid lg:grid-cols-3 lg:gap-4">
        <div class="order-3 flex flex-col items-start gap-5 lg:order-1">
          {{ logo }}
          <p class="max-w-80 text-body-sm text-text-muted max-lg:max-w-none">{{ about }}</p>
          {% render 'social-links', size: 'sm' %}
        </div>

        <nav class="order-2" aria-label="{{ menu_label }}">
          <div class="grid grid-cols-3 gap-4 max-lg:hidden">
            {%- if nested -%}
              {%- for column in menu.links -%}
                {%- if column.links.size > 0 -%}
                  {%- assign column_title = column.title | escape -%}
                  <div class="flex flex-col gap-4">
                    {% render 'menu-heading', title: column_title, style: 'caps' %}
                    {% render 'menu-links', links: column.links, size: 'sm' %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- elsif menu.links.size > 0 -%}
              {%- assign column_title = menu.title | escape -%}
              <div class="flex flex-col gap-4">
                {% render 'menu-heading', title: column_title, style: 'caps' %}
                {% render 'menu-links', links: menu.links, size: 'sm' %}
              </div>
            {%- endif -%}
          </div>
          <div class="lg:hidden">
            {%- if nested -%}
              {%- for column in menu.links -%}
                {%- if column.links.size > 0 -%}
                  {%- assign column_title = column.title | escape -%}
                  {%- capture column_links -%}{% render 'menu-links', links: column.links, size: 'sm', class: 'pb-5' %}{%- endcapture -%}
                  {% render 'accordion-item', title: column_title, icon: 'plus', content: column_links %}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif menu.links.size > 0 -%}
              {%- assign column_title = menu.title | escape -%}
              {%- capture column_links -%}{% render 'menu-links', links: menu.links, size: 'sm', class: 'pb-5' %}{%- endcapture -%}
              {% render 'accordion-item', title: column_title, icon: 'plus', content: column_links %}
            {%- endif -%}
          </div>
        </nav>

        <div class="order-1 lg:order-3">
          {% render 'newsletter-signup', id: 'footer-newsletter', layout: 'stacked-left', input_style: 'inline' %}
        </div>
      </div>

      {% render 'divider', class: 'max-lg:hidden' %}

      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <nav class="order-3 lg:order-1" aria-label="{{ legal_label }}">{{ legal }}</nav>
        <div class="order-1 flex flex-col items-start gap-5 lg:order-2 lg:flex-row lg:items-center lg:gap-6">
          <div class="flex items-center gap-1">
            {% render 'localization-selector', style: 'ghost', id: 'footer-localization', placement: 'top' %}
            {% render 'localization-selector', field: 'country', style: 'ghost', id: 'footer-country', placement: 'top' %}
          </div>
          {% render 'payment-icons' %}
        </div>
      </div>
    </div>
</footer>
