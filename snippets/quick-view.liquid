{%- comment -%}
  Figma: Components Molecules / Quick view (side-drawer, size lg)
  Rendered once in layout/theme.liquid. Any [data-quick-view-trigger][data-product-url] button opens it:
  quick-view.js fetches <product url>?section_id=quick-view-product, fills the drawer body and opens the drawer.
  The content is sections/quick-view-product.liquid (gallery left, product form right).
  JS: quick-view.js and side-drawer.js. Adding to the cart closes it (product-form:added).
{%- endcomment -%}
{%- assign title = 'sections.quick_view.title' | t -%}
{%- capture body -%}
  <div data-quick-view-body></div>
{%- endcapture -%}
<quick-view>
  <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
  {% render 'side-drawer', id: 'quick-view', title: title, size: 'lg', body: body %}
</quick-view>
