{%- comment -%}
  Figma: Components Atoms / Search suggestion
  One text result in predictive search, a listbox option.
  type     query | title                             (Figma: Type)
           query shows the search icon and styled_text: Shopify marks the typed part; it stays regular, the rest is medium
  text     the text (query.styled_text or a title, already safe)
  label    plain text for aria-label (query.text)
  href     required
  id       required, the option id for aria-activedescendant
  Hover = :hover (surface), Selected = [aria-selected=true] (surface-alt), set by search-form.js.
{%- endcomment -%}
{%- liquid
  assign type = type | default: 'title'
  if type == 'query'
    assign text_cls = 'text-body-base font-medium text-text [&_mark]:bg-transparent [&_mark]:font-normal [&_mark]:text-text'
  else
    assign text_cls = 'text-label-base text-text'
  endif
-%}
<li
  id="{{ id }}"
  class="search-suggestion rounded-xs transition-colors hover:bg-surface aria-selected:bg-surface-alt"
  role="option"
  aria-selected="false"
>
  <a href="{{ href }}" class="flex items-center gap-3 p-3 outline-none" tabindex="-1"{% if label %} aria-label="{{ label | escape }}"{% endif %}>
    {%- if type == 'query' -%}
      <span class="size-4 shrink-0 text-text [&>svg]:size-full" aria-hidden="true">{{ 'icon__search.svg' | inline_asset_content }}</span>
    {%- endif -%}
    <span class="{{ text_cls }}">{{ text }}</span>
  </a>
</li>
