  [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[0.15em] [&_a:hover]:no-underline [&_a:hover]:text-accent-hover
  [&_strong]:font-semibold [&_b]:font-semibold
  [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:list-disc [&_ul]:pl-7 [&_ol]:flex [&_ol]:flex-col [&_ol]:gap-2 [&_ol]:list-decimal [&_ol]:pl-7 [&_li]:pl-1
  [&_blockquote]:border-l-2 [&_blockquote]:border-text [&_blockquote]:pl-6 [&_blockquote]:text-heading-5 [&_blockquote_cite]:mt-3 [&_blockquote_cite]:block [&_blockquote_cite]:text-body-sm [&_blockquote_cite]:not-italic [&_blockquote_cite]:text-text-muted
