{%- comment -%}
  Figma: Components Atoms / Toggle switch
  label, id, name, value, checked, disabled, class, attributes   (Figma: Label, Show label, Checked)
  Native checkbox with role="switch"; the track and knob are the input itself.
  States: Hover = :hover, Focus = :focus-visible, Checked = :checked, Disabled = [disabled]
{%- endcomment -%}
<label class="toggle-switch inline-flex items-center gap-3 text-body-base text-text cursor-pointer has-[:disabled]:text-text-disabled has-[:disabled]:cursor-not-allowed {{ class }}">
  <input
    type="checkbox"
    role="switch"
    class="peer relative h-6 w-10 shrink-0 appearance-none rounded-full bg-track px-1 transition-colors cursor-pointer outline-none hover:bg-track-hover focus-visible:border focus-visible:border-focus checked:bg-accent checked:hover:bg-accent-hover disabled:bg-disabled disabled:cursor-not-allowed before:absolute before:top-1 before:left-1 before:size-4 before:rounded-full before:bg-background before:transition-transform checked:before:translate-x-4 disabled:before:bg-surface"
    {%- if id %} id="{{ id }}"{% endif -%}
    {%- if name %} name="{{ name }}"{% endif -%}
    {%- if value %} value="{{ value | escape }}"{% endif -%}
    {%- if checked %} checked{% endif -%}
    {%- if disabled %} disabled{% endif -%}
    {%- if attributes %} {{ attributes }}{% endif -%}
  >
  {%- if label %}<span>{{ label }}</span>{% endif -%}
</label>
